# Telemt Anti-TSPU Decoy Server
# Listens on loopback only. Intercepts failed probes and non-Telegram HTTP traffic,
# returning genuine HTTP 200 OK with cover site instead of revealing synthetic 404s.

server {
    listen 127.0.0.1:__TG_DECOY_PORT__;
    server_name 127.0.0.1;

    root /var/www/html;
    index index.html index.htm;

    # Always return genuine 200 OK with cover page
    location / {
        try_files $uri /index.html =200;
    }
}
