#!/usr/bin/env bash
# Build Timestamp: 19:15.28.10.2026
# ==============================================================================
# «КОНФИГУРИРОВАНИЕ СЕРВЕРА» (SERVER-MGR CLI TOOL)
# ==============================================================================

set -eo pipefail

C_RESET='\e[0m'
C_BOLD='\e[1m'
C_RED='\e[1;31m'
C_GREEN='\e[1;32m'
C_YELLOW='\e[1;33m'
C_BLUE='\e[1;34m'
C_CYAN='\e[1;36m'

msg_ok()   { printf "${C_GREEN}[✓] %s${C_RESET}\n" "$1"; }
msg_err()  { printf "${C_RED}[✗] %s${C_RESET}\n" "$1"; }
msg_inf()  { printf "${C_BLUE}[i] %s${C_RESET}\n" "$1"; }
msg_warn() { printf "${C_YELLOW}[!] %s${C_RESET}\n" "$1"; }

CONFIG_FILE="/etc/server-manager/config.json"
PY_SCRIPT="/usr/local/bin/server-manager.py"

[[ $EUID -ne 0 ]] && { msg_err "Команда должна быть запущена с правами root (sudo server-mgr)"; exit 1; }

get_conf_val() {
    local key="$1"
    if [[ -f "$CONFIG_FILE" ]]; then
        python3 -c "import json; f=open('$CONFIG_FILE'); d=json.load(f); print(d.get('$key', ''))" 2>/dev/null || true
    fi
}

cmd_open() {
    local mins="${1:-30}"
    local port
    port=$(get_conf_val "mgmt_port")
    local domain
    domain=$(get_conf_val "domain")
    local path
    path=$(get_conf_val "mgmt_secret_path")

    if [[ -z "$port" ]]; then
        msg_err "Не найден порт в $CONFIG_FILE"
        exit 1
    fi

    # Open port via python daemon helper
    python3 "$PY_SCRIPT" open "$mins" > /dev/null 2>&1 || {
        ufw allow "${port}/tcp" comment 'Server Manager' > /dev/null 2>&1 || true
        ufw reload > /dev/null 2>&1 || true
    }

    echo
    msg_ok "Порт модуля управления (${port}) УСПЕШНО ОТКРЫТ в UFW!"
    echo -e "  ${C_CYAN}URL для входа:${C_RESET}       https://${domain}:${port}/"
    echo -e "  ${C_CYAN}Секретный путь:${C_RESET}      /${path}/"
    echo -e "  ${C_CYAN}Авто-таймер:${C_RESET}        ${mins} минут (закроется автоматически)"
    echo -e "  ${C_YELLOW}Для немедленного закрытия:${C_RESET} server-mgr close (или кнопка «Выход» в веб-интерфейсе)"
    echo
}

cmd_close() {
    python3 "$PY_SCRIPT" close > /dev/null 2>&1 || true
    local port
    port=$(get_conf_val "mgmt_port")
    if [[ -n "$port" ]]; then
        ufw delete allow "${port}/tcp" > /dev/null 2>&1 || true
        ufw delete allow "$port" > /dev/null 2>&1 || true
        ufw reload > /dev/null 2>&1 || true
    fi
    echo
    msg_ok "Порт модуля управления ЗАБЛОКИРОВАН в файрволе UFW."
    msg_inf "Открытыми остались только системные порты: 22 (SSH) и 443 (TCP/UDP)."
    echo
}

cmd_status() {
    local port
    port=$(get_conf_val "mgmt_port")
    local domain
    domain=$(get_conf_val "domain")
    local path
    path=$(get_conf_val "mgmt_secret_path")
    local user
    user=$(get_conf_val "auth_user")

    echo
    echo -e "${C_BOLD}=== СТАТУС МОДУЛЯ «КОНФИГУРИРОВАНИЕ СЕРВЕРА» ===${C_RESET}"
    echo -e "  Служба systemd:     $(systemctl is-active server-manager 2>/dev/null || echo 'inactive')"
    echo -e "  Домен:              ${domain}"
    echo -e "  Порт управления:    ${port}"
    echo -e "  Секретный путь:     /${path}/"
    echo -e "  Логин админа:       ${user}"

    local ufw_status="ЗАКРЫТ (Stealth)"
    if ufw status | grep -q "${port}/tcp.*ALLOW"; then
        ufw_status="ОТКРЫТ (Активен)"
        if [[ -f "/etc/server-manager/auto_lock.timer" ]]; then
            local expiry
            expiry=$(cat "/etc/server-manager/auto_lock.timer" 2>/dev/null || echo "")
            if [[ -n "$expiry" ]]; then
                local rem
                rem=$(python3 -c "import time; e=float('$expiry'); r=int(e - time.time()); print(f'осталось {r//60} мин. {r%60} сек.' if r > 0 else 'таймер истекает...')")
                ufw_status="ОТКРЫТ (Авто-таймер: ${rem})"
            fi
        fi
    fi
    echo -e "  Статус порта в UFW: ${ufw_status}"
    echo
}

cmd_reset_pass() {
    echo
    echo -e "${C_BOLD}Смена пароля администратора модуля «Конфигурирование сервера»:${C_RESET}"
    read -rsp "-> Введите новый пароль: " NEW_PASS
    echo
    read -rsp "-> Повторите новый пароль: " NEW_PASS2
    echo

    if [[ "$NEW_PASS" != "$NEW_PASS2" ]]; then
        msg_err "Пароли не совпадают!"
        exit 1
    fi

    if [[ -z "$NEW_PASS" ]]; then
        msg_err "Пароль не может быть пустым!"
        exit 1
    fi

    python3 -c "
import json, hashlib, secrets
salt = b'server_manager_salt_3x'
h = hashlib.pbkdf2_hmac('sha256', '$NEW_PASS'.encode('utf-8'), salt, 100000).hex()
with open('$CONFIG_FILE', 'r') as f:
    d = json.load(f)
d['auth_pass_hash'] = h
d['auth_pass_plain'] = '$NEW_PASS'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
"
    msg_ok "Пароль успешно обновлен! Служба перезапускается..."
    systemctl restart server-manager 2>/dev/null || true
}

show_menu() {
    clear
    echo -e "${C_CYAN}"
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════════════════════════╗
║               МОДУЛЬ «КОНФИГУРИРОВАНИЕ СЕРВЕРА» (SERVER-MGR)                     ║
╚══════════════════════════════════════════════════════════════════════════════════╝
EOF
    echo -e "${C_RESET}"
    cmd_status

    echo -e "${C_BOLD}Выберите действие:${C_RESET}"
    echo "1 - Открыть порт модуля в UFW (с авто-таймером 30 мин)"
    echo "2 - Заблокировать порт модуля в UFW (закрыть всё кроме 22 и 443)"
    echo "3 - Показать ссылки для подключения (/root/server_credentials.txt)"
    echo "4 - Перезапустить службу модуля управления"
    echo "5 - Сменить пароль администратора модуля"
    echo "0 - Выход"
    echo
    read -rp "Ваш выбор [0-5]: " CHOICE

    case "$CHOICE" in
        1)
            read -rp "Укажите время работы в минутах [30]: " M
            cmd_open "${M:-30}"
            ;;
        2)
            cmd_close
            ;;
        3)
            if [[ -f "/root/server_credentials.txt" ]]; then
                echo
                cat "/root/server_credentials.txt"
            else
                msg_warn "Файл /root/server_credentials.txt не найден."
            fi
            ;;
        4)
            systemctl restart server-manager
            msg_ok "Служба server-manager перезапущена."
            ;;
        5)
            cmd_reset_pass
            ;;
        0)
            exit 0
            ;;
        *)
            msg_err "Неверный выбор."
            ;;
    esac
}

case "${1:-}" in
    open)
        cmd_open "${2:-30}"
        ;;
    close)
        cmd_close
        ;;
    status)
        cmd_status
        ;;
    restart)
        systemctl restart server-manager
        msg_ok "Служба перезапущена."
        ;;
    reset-pass)
        cmd_reset_pass
        ;;
    "")
        show_menu
        ;;
    *)
        echo "Использование: server-mgr [open <минуты>|close|status|restart|reset-pass]"
        exit 1
        ;;
esac
